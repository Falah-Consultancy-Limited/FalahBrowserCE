{
  "name": "desktop",
  "private": true,
  "version": "1.0.1",
  "description": "A sovereign, secure browser for the Ummah.",
  "author": "Maifors",
  "repository": {
    "type": "git",
    "url": "https://github.com/maifors/falah-browser.git"
  },
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "start": "electron .",
    "build": "vite build && electron-builder",
    "build:web": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "concurrently": "^8.2.0",
    "electron-store": "^8.1.0",
    "node-fetch": "^3.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "postcss": "^8.4.32",
    "sucrase": "^3.35.1",
    "tailwindcss": "^3.4.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.falah.browser",
    "productName": "FalahBrowser",
    "files": [
      "dist/**/*",
      "main.cjs",
      "preload.cjs",
      "public/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "icon": "public/lantern.png",
      "artifactName": "${productName}-${version}.${ext}"
    },
    "win": {
      "target": "nsis",
      "icon": "public/lantern.png",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/lantern.png",
      "artifactName": "${productName}-${version}.${ext}"
    }
  }
}
