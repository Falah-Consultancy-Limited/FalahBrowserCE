# Falah Browser — Docker environment variables
# Copy to .env and adjust before running docker compose up

# noVNC web port (access the browser at http://<host>:NOVNC_PORT)
NOVNC_PORT=6080

# Raw VNC port (for direct VNC client access)
VNC_PORT=5900

# VNC password (leave blank for no auth — not recommended in production)
VNC_PASSWORD=falah123
